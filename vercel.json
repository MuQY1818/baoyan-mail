{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/celebration", "permanent": false }
  ],
  "headers": [
    { "source": "/archive", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/archive/", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    {
      "source": "/api/ddl",
      "destination": "https://baoyan-mail.weijuebu.workers.dev/api/ddl"
    },
    {
      "source": "/api/missing-link",
      "destination": "https://baoyan-mail.weijuebu.workers.dev/api/missing-link"
    },
    {
      "source": "/api/analytics/visit",
      "destination": "https://baoyan-mail.weijuebu.workers.dev/api/analytics/visit"
    },
    {
      "source": "/api/analytics/summary",
      "destination": "https://baoyan-mail.weijuebu.workers.dev/api/analytics/summary"
    },
    { "source": "/celebration", "destination": "/index.html" },
    { "source": "/celebration/", "destination": "/index.html" },
    { "source": "/archive", "destination": "/index.html" },
    { "source": "/archive/", "destination": "/index.html" }
  ]
}
